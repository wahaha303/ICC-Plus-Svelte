{
  "name": "iccplus_viewer",
  "private": true,
  "version": "2.10.12",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.config.local.ts && node build-core.js && node build-index.js && node add-comment.js && node build-local-index.js",
    "preview": "vite build && node build-core.js && node build-index.js && node add-comment.js && vite preview",
    "prepare": "npm run smui-theme-light && npm run smui-theme-dark",
    "smui-theme-light": "smui-theme compile public/css/smui.css -i src/theme",
    "smui-theme-dark": "smui-theme compile public/css/smui-dark.css -i src/theme/dark",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "postinstall": "patch-package"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/canvas-size": "^1.2.2",
    "@types/node": "^26.6.5",
    "@types/youtube": "^0.3.0",
    "@vitejs/plugin-legacy": "^8.2.3",
    "core-js": "^3.51.0",
    "smui-theme": "^9.0.6",
    "svelte-check": "^4.3.1",
    "terser": "^5.51.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@antv/expr": "^1.0.2",
    "@smui/button": "^9.0.6",
    "@smui/common": "^9.0.6",
    "@smui/dialog": "^9.0.6",
    "@smui/drawer": "^9.0.6",
    "@smui/form-field": "^9.0.6",
    "@smui/icon-button": "^9.0.6",
    "@smui/list": "^9.0.6",
    "@smui/paper": "^9.0.6",
    "@smui/select": "^9.0.6",
    "@smui/slider": "^9.0.6",
    "@smui/snackbar": "^9.0.6",
    "@smui/switch": "^9.0.6",
    "@smui/tab": "^9.0.6",
    "@smui/tab-bar": "^9.0.6",
    "@smui/textfield": "^9.0.6",
    "@smui/tooltip": "^9.0.6",
    "@smui/top-app-bar": "^9.0.6",
    "bootstrap": "^5.3.8",
    "cropperjs": "^2.3.1",
    "dompurify": "^3.4.17",
    "html-to-image": "^1.11.13",
    "patch-package": "^8.0.1",
    "propper": "^1.0.4",
    "resize-observer-polyfill": "^1.5.1",
    "ress": "^6.0.0",
    "svelte": "^5.57.2",
    "svelte-material-ui": "^9.0.6",
    "zod": "^4.6.7"
  }
}
